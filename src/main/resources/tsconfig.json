{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // XP runtime globals (resolve, app, log, __, ...) — vp pack does the emit.
    "types": ["@enonic-types/global"],
    // Type the absolute XP requires; vp pack keeps them external at build time.
    "paths": {
      "/lib/xp/core": ["../../../node_modules/@enonic-types/core"],
      "/lib/xp/*": ["../../../node_modules/@enonic-types/lib-*"],
      "/lib/*": ["./lib/*"]
    }
  },
  "include": ["./**/*.ts"],
  // Tests are vitest's, checked by `vp test`; pulling vitest types into the XP config is the
  // wrong direction. Vendored code is also imported, so `exclude` cannot skip it — see
  // lib/blurhash/vendor/README.md for how that is handled.
  "exclude": ["assets/**", "**/*.test.ts"]
}
